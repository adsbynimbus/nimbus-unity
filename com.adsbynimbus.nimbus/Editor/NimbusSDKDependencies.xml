<dependencies>
  <androidPackages>
    <androidPackage spec="com.adsbynimbus.android:nimbus:3.0.0-rc.1">
      <repositories>
        <repository>https://adsbynimbus-public.s3.amazonaws.com/android/sdks</repository>
      </repositories>
    </androidPackage>
    <!--The below package is needed to resolve gradle issues with APS-->
    <androidPackage spec="com.google.android.material:material:1.12.0"/>
    <androidPackage spec="org.jetbrains.kotlinx:kotlinx-serialization-json:1.10.0"/>
    <androidPackage spec="org.jetbrains.kotlin:kotlin-reflect:2.3.21"/>
  </androidPackages>

  <iosPods>
    <!--The below pod does not include subspecs and extensions because those are added dynamically in IOSPostBuildProcessor.cs-->
    <iosPod name="NimbusSDK" version="3.0.0-rc.1" bitcodeEnabled="false" 
            addToAllTargets="false"/>
  </iosPods>
</dependencies>
